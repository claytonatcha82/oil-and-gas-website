{
  "rewrites": [
    { "source": "/((?!assets/|favicon|robots.txt|sitemap.xml|og-image).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
